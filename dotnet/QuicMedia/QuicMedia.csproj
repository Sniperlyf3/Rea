<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Add MAUI TFMs (net8.0-android / net8.0-ios) when building the mobile package. -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>QuicMedia</PackageId>
    <Version>0.1.0</Version>
    <Authors>Rea contributors</Authors>
    <Description>QUIC-based real-time audio + reliable data transport. The full media path (capture → Opus → QUIC datagrams → jitter buffer → render) runs in a native Rust core; C# is control-plane only.</Description>
    <PackageTags>quic;rtp;audio;opus;realtime;streaming;native;interop</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Sniperlyf3/Rea</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

  <!--
    Native libraries are produced by build/build-native.(sh|ps1) into
    dotnet/QuicMedia/runtimes/<rid>/native/ before packing. The runtimes/<rid>/native
    convention makes NuGet deploy the right binary for each consumer RID automatically.
    Expected layout:
      runtimes/win-x64/native/quicmedia.dll
      runtimes/linux-x64/native/libquicmedia.so
      runtimes/osx-arm64/native/libquicmedia.dylib
      runtimes/android-arm64/native/libquicmedia.so
      (iOS links the static libquicmedia.a at app build time via the MAUI target.)
  -->
  <ItemGroup Condition="Exists('runtimes')">
    <None Include="runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
